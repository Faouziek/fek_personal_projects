* text=auto

# Source code

# Python
*.py text eol=lf
*.pyi text eol=lf

# C / C++
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf

# Build systems
Makefile text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.mk text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Config and documentation

*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ini text eol=lf

.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.a binary
*.lib binary
*.pdb binary
